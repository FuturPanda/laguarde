{
  "name": "laguarde",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hostable policy control plane for AI coding agents",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:seed": "bun src/db/seed-cli.ts",
    "export:onboarding": "bun scripts/export-onboarding.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.22.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.21",
    "typescript": "^5.9.3"
  }
}
