{
  "name": "laguarde-mcp",
  "version": "0.3.0",
  "type": "module",
  "description": "Self-hostable policy control plane for AI coding agents",
  "mcpName": "dev.futur-panda/laguarde",
  "bin": {
    "laguarde-mcp": "dist/stdio.js",
    "laguarde": "dist/stdio.js",
    "laguarde-daemon": "dist/daemon-cli.js"
  },
  "files": [
    "dist",
    "public",
    "llms.txt",
    "README.md",
    "server.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://www.futur-panda.dev/laguarde/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FuturPanda/laguarde.git"
  },
  "bugs": {
    "url": "https://github.com/FuturPanda/laguarde/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "policy",
    "guardrails",
    "self-hosted"
  ],
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "bun build src/server.ts src/stdio.ts src/daemon-cli.ts --outdir dist --target node --packages external --sourcemap=external",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:seed": "bun src/db/seed-cli.ts",
    "export:onboarding": "bun scripts/export-onboarding.ts",
    "registry:validate": "bun scripts/validate-server-json.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.22.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.21",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3"
  }
}
